# Supabase Configuration
# Get these from your Supabase project settings
# https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Edge Functions Configuration (for local development)
# These are used by Supabase functions
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================================
# MICROSOFT AZURE AI SERVICES (REQUIRED for Imagine Cup 2026)
# ============================================================
# This project uses TWO Microsoft AI services as required:
# 1. Azure AI Language Service - Key phrase extraction & entity recognition
# 2. Azure OpenAI Service - Advanced reasoning and generation
#
# Both services are REQUIRED for the system to function.
# Removing either service breaks the analysis pipeline.
# ============================================================

# Azure AI Language Service
# Create at: https://portal.azure.com -> Create Resource -> AI + Machine Learning -> Language Service
# Get endpoint and key from: Resource -> Keys and Endpoint
AZURE_LANGUAGE_ENDPOINT=https://your-language-service.cognitiveservices.azure.com
AZURE_LANGUAGE_KEY=your_azure_language_key

# Azure OpenAI Service
# Create at: https://portal.azure.com -> Create Resource -> AI + Machine Learning -> Azure OpenAI
# Deploy a model (e.g., gpt-4, gpt-35-turbo) in Azure OpenAI Studio
# Get endpoint and key from: Resource -> Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://your-openai-service.openai.azure.com
AZURE_OPENAI_KEY=your_azure_openai_key
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name

# ============================================================
# END AZURE AI CONFIGURATION
# ============================================================

# GitHub Integration (Optional)
# Personal access token for higher GitHub API rate limits
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token

# Job API Integrations (Optional)
# These provide real job listings from various sources
# Adzuna API - Sign up at: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_api_key

# JSearch API via RapidAPI - Sign up at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your_rapidapi_key

# Application Configuration
VITE_APP_NAME="AI Career Copilot"
VITE_APP_URL=http://localhost:5173
